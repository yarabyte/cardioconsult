# Copier vers .env.local — aucune donnée réelle. Valeurs alignées sur docker-compose.yml.

NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_ROOT_DOMAIN=cardiosoins.com

# Postgres local : `pnpm compose:up` (Docker) OU rôle/bases créés sur Homebrew (voir README)
DATABASE_URL=postgresql://cardioconsult:cardioconsult@127.0.0.1:5432/cc_control
DATABASE_ADMIN_URL=postgresql://cardioconsult:cardioconsult@127.0.0.1:5432/cc_control
DATABASE_URL_TEST=postgresql://cardioconsult:cardioconsult@127.0.0.1:5432/cc_control_test

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-secret
S3_BUCKET=cardiosoins-dev
S3_FORCE_PATH_STYLE=true

GOTENBERG_URL=http://127.0.0.1:3001
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Local (Mailpit) : host 127.0.0.1 port 1025, sans auth
# Production cardiosoins.com : SMTP 465 SSL + auth
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@cardiosoins.local
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ≥ 32 caractères — remplacer hors développement
APP_SECRET=dev-only-change-me-32chars-minimum!!
BETTER_AUTH_URL=http://localhost:3000
PSC_ENABLED=false

LOG_LEVEL=info

# Facturation (P16) — prix / price IDs hors code ; jamais de données patient vers Stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO_EUR=49
STRIPE_PRICE_CABINET_EUR=149
# STRIPE_PRICE_ID_SOLO=price_xxx
# STRIPE_PRICE_ID_CABINET=price_yyy
# STRIPE_PRICE_ID_CLINIQUE=price_zzz
BILLING_GRACE_DAYS=7

# Console plateforme (P17)
# CONSOLE_IP_ALLOWLIST=203.0.113.10,198.51.100.0/24
CONSOLE_REQUIRE_PASSKEY=true

# Observabilité (P19) — collecteur OTLP dans le périmètre HDS uniquement
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Production applicative : NEXT_PUBLIC_APP_ENV=production implique un APP_SECRET dédié (≥ 32 caractères)
