# Démo / préprod Lightsail + Coolify — renseigner dans l’UI Coolify (Shared env).
# Aucune donnée réelle. Ne jamais committer de secrets.

NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_ROOT_DOMAIN=cardiosoins.com

# Postgres (réseau Docker interne — ne pas publier le port)
POSTGRES_USER=cardioconsult
POSTGRES_PASSWORD=CHANGE_ME_postgres_demo
POSTGRES_DB=cc_control
DATABASE_URL=postgresql://cardioconsult:CHANGE_ME_postgres_demo@postgres:5432/cc_control
DATABASE_ADMIN_URL=postgresql://cardioconsult:CHANGE_ME_postgres_demo@postgres:5432/cc_control
DATABASE_URL_TEST=postgresql://cardioconsult:CHANGE_ME_postgres_demo@postgres:5432/cc_control_test

# MinIO (S3-compatible démo)
S3_ENDPOINT=http://minio:9000
S3_REGION=eu-north-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=CHANGE_ME_minio_demo
S3_BUCKET=cardiosoins-demo
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_demo

GOTENBERG_URL=http://gotenberg:3000
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# SMTP transactionnel — jamais de contenu clinique / nom patient
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_FROM=noreply@cardiosoins.com
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true

# ≥ 32 caractères — générer : openssl rand -base64 48
APP_SECRET=CHANGE_ME_generate_32chars_minimum_secret!!
BETTER_AUTH_URL=https://cardiosoins.com
PSC_ENABLED=false

LOG_LEVEL=info

# Console : passkey obligatoire ; allowlist IP optionnelle
CONSOLE_REQUIRE_PASSKEY=true
# CONSOLE_IP_ALLOWLIST=203.0.113.10

BILLING_GRACE_DAYS=7
STRIPE_PRICE_SOLO_EUR=49
STRIPE_PRICE_CABINET_EUR=149
