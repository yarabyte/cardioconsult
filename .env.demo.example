# Démo / préprod Coolify (ressources natives) — coller dans l’UI Coolify.
# Aucune donnée réelle. Ne jamais committer de secrets.
# HOST_INTERNE_POSTGRES = hostname fourni par la ressource PostgreSQL Coolify.

NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_ROOT_DOMAIN=cardiosoins.com
# Démo / préprod hors HDS uniquement. Production clinique → kms + Vault.
CRYPTO_KEY_MANAGER=local-dev

DATABASE_URL=postgresql://USER:PASSWORD@HOST_INTERNE_POSTGRES:5432/cc_control
DATABASE_ADMIN_URL=postgresql://USER:PASSWORD@HOST_INTERNE_POSTGRES:5432/cc_control

# Optionnel au 1er deploy (uploads / PDF / antivirus) — renseigner après ajout des services
# S3_ENDPOINT=http://HOST_INTERNE_MINIO:9000
# S3_REGION=eu-north-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=cardiosoins-demo
# S3_FORCE_PATH_STYLE=true
# GOTENBERG_URL=http://HOST_INTERNE_GOTENBERG:3000
# CLAMAV_HOST=HOST_INTERNE_CLAMAV
# CLAMAV_PORT=3310

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_FROM=noreply@cardiosoins.com
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true

# openssl rand -base64 48
APP_SECRET=CHANGE_ME_generate_32chars_minimum_secret!!
BETTER_AUTH_URL=https://cardiosoins.com
PSC_ENABLED=false

LOG_LEVEL=info
CONSOLE_REQUIRE_PASSKEY=true
# CONSOLE_IP_ALLOWLIST=203.0.113.10

BILLING_GRACE_DAYS=7
STRIPE_PRICE_SOLO_EUR=49
STRIPE_PRICE_CABINET_EUR=149
