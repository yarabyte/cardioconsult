# Démo Lightsail — docker compose direct (sans Coolify).
# Copier vers .env.demo sur le serveur. Ne jamais committer de secrets.
# Données synthétiques uniquement. Hors HDS.

POSTGRES_USER=cardioconsult
POSTGRES_PASSWORD=CHANGE_ME_fort_password
POSTGRES_DB=cc_control

DATABASE_URL=postgresql://cardioconsult:CHANGE_ME_fort_password@postgres:5432/cc_control
DATABASE_ADMIN_URL=postgresql://cardioconsult:CHANGE_ME_fort_password@postgres:5432/cc_control

NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_ROOT_DOMAIN=cardiosoins.com
CRYPTO_KEY_MANAGER=local-dev

# openssl rand -base64 48
APP_SECRET=CHANGE_ME_generate_32chars_minimum_secret!!
BETTER_AUTH_URL=https://cardiosoins.com

CADDY_ACME_EMAIL=noreply@cardiosoins.com

# SMTP (mail Contabo ou autre). Laisser 127.0.0.1 si pas encore prêt.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@cardiosoins.com
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

LOG_LEVEL=info
CONSOLE_REQUIRE_PASSKEY=true

BILLING_GRACE_DAYS=7
STRIPE_PRICE_SOLO_EUR=49
STRIPE_PRICE_CABINET_EUR=149

