# Apex/www/console : certs au démarrage. Tenants : on-demand à la 1ʳᵉ visite.

{
	email {$CADDY_ACME_EMAIL:noreply@cardiosoins.com}
	on_demand_tls {
		ask http://app:3000/api/caddy-ask
	}
}

cardiosoins.com, www.cardiosoins.com, console.cardiosoins.com {
	encode zstd gzip
	reverse_proxy app:3000
}

