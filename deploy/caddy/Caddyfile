# Démo Lightsail — TLS HTTP-01.
# Pas de site `*.domaine` (sinon Caddy tente un wildcard ACME DNS-01 et bloque).
# Tenants : on-demand via le catch-all :443 + /api/caddy-ask.

{
	email {$CADDY_ACME_EMAIL:noreply@cardiosoins.com}
	on_demand_tls {
		ask http://app:3000/api/caddy-ask
	}
}

cardiosoins.com, www.cardiosoins.com, console.cardiosoins.com {
	encode zstd gzip
	reverse_proxy app:3000
}

:443 {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy app:3000
}
