# Démo Lightsail — TLS HTTP-01 (cert par hôte à la demande pour les tenants).
# DNS Contabo : A @ et * → IP Lightsail. Mail hors de ce proxy.

{
	email {$CADDY_ACME_EMAIL:noreply@cardiosoins.com}
	# Limite les émissions (wildcard DNS A = tout sous-domaine résout).
	on_demand_tls {
		ask http://app:3000/api/caddy-ask
	}
}

cardiosoins.com, www.cardiosoins.com {
	encode zstd gzip
	reverse_proxy app:3000
}

console.cardiosoins.com {
	encode zstd gzip
	reverse_proxy app:3000
}

*.cardiosoins.com {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy app:3000
}
